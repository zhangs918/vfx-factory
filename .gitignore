# Generated Web VFX payloads can be several GB and may contain derivatives of
# licensed source assets. Regenerate them locally with the export scripts.
public/assets/quarks/
public/assets/runtime-v2-candidates/
public/assets/frozen-quarks/
public/assets/v3-artifacts/
public/assets/v3-code/
public/assets/v3-resources/
public/assets/.runtime-v3-stage-*/
public/assets/.runtime-v3-backup-*/
public/unity-ref

# Image/state oracles are regenerated locally and may derive from licensed VFX.
tests/vfx-regression/baselines/

# Runtime logs / crash dumps
*.log
*.crash
