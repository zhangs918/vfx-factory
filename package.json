{
  "name": "vfx_factory",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "quarks": "vite --open /",
    "build": "tsc --noEmit && npm run check:schema-runtime && npm run check:thin-player-graph && vite build && npm run check:player-bundle",
    "preview": "vite preview",
    "setup:quarks-exporter": "python3 scripts/setup_quarks_exporter.py",
    "inject:cfxr": "node scripts/inject_cfxr_materials.mjs",
    "compare:cfxr": "node scripts/compare_cfxr_fidelity.mjs",
    "regression:semantic": "node scripts/capture_semantic_regression.mjs",
    "regression:semantic:update": "node scripts/capture_semantic_regression.mjs --update",
    "test:e2e": "npm run build && npm run validate:artifact-contract && npm run regression:semantic -- --all",
    "regression:unity": "bash scripts/capture_unity_regression.sh",
    "regression:oracle": "node scripts/compare_live_to_oracle.mjs",
    "regression:oracle:impact": "node scripts/compare_live_to_oracle.mjs --effect=impact",
    "validate:live-ir": "node scripts/validate_live_ir.mjs",
    "validate:artifact-contract": "node scripts/validate_artifact_contract.mjs",
    "validate:candidate-ir": "node scripts/validate_candidate_ir.mjs",
    "validate:material-ir": "node scripts/validate_material_ir.mjs",
    "smoke:candidate-runtime": "node scripts/smoke_candidate_runtime.mjs",
    "validate:loop": "node scripts/auto_validate_loop.mjs",
    "compile:source-check": "node scripts/compile_source_check.mjs",
    "compile:runtime-v2": "tsx scripts/compile_runtime_v2.ts",
    "compile:frozen-quarks": "tsx scripts/compile_frozen_quarks.ts",
    "regression:frozen-quarks": "node scripts/regress_frozen_quarks.mjs",
    "index:frozen-resources": "tsx scripts/build_frozen_resource_index.ts",
    "index:frozen-materials": "tsx scripts/build_frozen_material_index.ts",
    "compile:runtime-v3": "tsx scripts/compile_runtime_v3.ts",
    "extract:runtime-v3-resources": "tsx scripts/extract_v3_resources.ts",
    "split:runtime-v3-code": "node scripts/split_runtime_v3_code.mjs",
    "strip:runtime-v3-embedded": "node scripts/strip_runtime_v3_embedded.mjs",
    "compile:runtime-v3:release": "node scripts/release_runtime_v3.mjs",
    "validate:runtime-v3-assets": "node scripts/validate_runtime_v3_assets.mjs",
    "capture:material-stamps": "node scripts/capture_bridge_material_stamps.mjs",
    "stamp:from-capture": "node scripts/stamp_artifact_from_capture.mjs",
    "qualify:material-capture": "node scripts/qualify_material_capture.mjs",
    "qualify:material-captures:manual": "node scripts/approve_material_captures_manual.mjs --all",
    "promote:capture-spot": "node scripts/promote_capture_spot.mjs",
    "regression:runtime-v3": "node scripts/regress_runtime_v3.mjs",
    "promote:runtime-v3": "node scripts/promote_runtime_v3.mjs",
    "restore:runtime-v3-qualification": "node scripts/restore_v3_qualification.mjs",
    "regression:runtime-v3:batch": "node scripts/batch_regress_runtime_v3.mjs",
    "qualify:material-families:loop": "node scripts/qualify_material_families_loop.mjs",
    "compile:runtime-v2:batch": "node scripts/compile_runtime_v2_batch.mjs",
    "regression:runtime-v2": "node scripts/regress_runtime_v2_artifacts.mjs",
    "check:player-bundle": "node scripts/check_player_bundle.mjs",
    "check:thin-player-graph": "node scripts/check_thin_player_graph.mjs",
    "check:schema-runtime": "tsx scripts/check_schema_runtime_parity.ts",
    "regression:candidate-oracles": "node scripts/regress_candidate_oracles.mjs",
    "promote:live-ir": "node scripts/promote_live_ir.mjs",
    "qualify:live-ir": "node scripts/qualify_live_ir.mjs",
    "export:quarks": "bash scripts/batch_export_quarks.sh",
    "export:quarks:all-assets": "bash scripts/batch_export_quarks.sh all-assets",
    "export:quarks:slash": "bash scripts/batch_export_quarks.sh slash",
    "export:quarks:impact-live": "bash scripts/batch_export_quarks.sh impact-live",
    "export:quarks:multiple-impact-live": "bash scripts/batch_export_quarks.sh multiple-impact-live",
    "export:quarks:multiple-slashes-live": "bash scripts/batch_export_quarks.sh multiple-slashes-live",
    "export:quarks:slash-fire-live": "bash scripts/batch_export_quarks.sh slash-fire-live",
    "export:quarks:slash-water-live": "bash scripts/batch_export_quarks.sh slash-water-live",
    "export:quarks:projectile-fire-live": "bash scripts/batch_export_quarks.sh projectile-fire-live",
    "export:quarks:projectile-earth-live": "bash scripts/batch_export_quarks.sh projectile-earth-live",
    "export:quarks:cfxr": "bash scripts/batch_export_quarks.sh cfxr",
    "export:baked:impact": "bash scripts/export_baked_impact.sh",
    "export:baked:multiple-impact": "bash scripts/export_baked_impact.sh multiple-impact",
    "export:semantic-fixture": "bash scripts/export_semantic_fixture.sh"
  },
  "dependencies": {
    "three": "^0.185.1",
    "three.quarks": "^0.17.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
